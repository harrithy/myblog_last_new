# Server / Security
PORT=8080
JWT_SECRET=change_me_to_a_long_random_secret
CORS_ALLOW_ORIGINS=*
AUTO_MIGRATE=true

# Owner/Admin login
OWNER_NAME=harrio
OWNER_ACCOUNT=harrio
OWNER_PASSWORD=change_me
OWNER_EMAIL=harrithy@github.com
OWNER_GITHUB_ID=156180607
OWNER_GITHUB_USERNAME=harrithy

# Database configuration
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=blog

# GitHub OAuth configuration
# Create credentials at https://github.com/settings/developers
GITHUB_CLIENT_ID=your_client_id_here
GITHUB_CLIENT_SECRET=your_client_secret_here

# Must match the callback configured in your GitHub OAuth App
# Local development: http://localhost:5173/callback
# Production example: https://blog.harrio.xyz/callback
GITHUB_REDIRECT_URI=http://localhost:5173/callback

# DeepSeek API configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# Optional. Default: https://api.deepseek.com
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Optional. Default: deepseek-chat
DEEPSEEK_MODEL=deepseek-chat

# Upload proxy configuration
IMAGE_HOST_URL=https://image.harrio.xyz/upload
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp
