# Server / Security
PORT=8080
JWT_SECRET=change_me_to_a_long_random_secret

# Owner/Admin login
OWNER_NAME=harrio
OWNER_ACCOUNT=harrio
OWNER_PASSWORD=change_me
OWNER_EMAIL=harrithy@github.com
OWNER_GITHUB_ID=156180607
OWNER_GITHUB_USERNAME=harrithy

# Database configuration
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=blog

# GitHub OAuth 配置（必填）
# 从 https://github.com/settings/developers 获取
GITHUB_CLIENT_ID=your_client_id_here
GITHUB_CLIENT_SECRET=your_client_secret_here

# 回调地址（需要和 GitHub OAuth App 设置一致）
# 本地开发: http://localhost:5173/callback
# 生产环境: https://blog.harrio.xyz/callback
GITHUB_REDIRECT_URI=http://localhost:5173/callback

# DeepSeek API Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# Optional. Default: https://api.deepseek.com
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Optional. Default: deepseek-chat
DEEPSEEK_MODEL=deepseek-chat
